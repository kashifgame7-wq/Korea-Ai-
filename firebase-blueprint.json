{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data for registered and anonymous users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Chat conversations belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "createdAt"]
    },
    "FavoriteImage": {
      "title": "FavoriteImage",
      "description": "User saved favorite AI generated images",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "prompt": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "style": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "imageUrl", "prompt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User chat sessions"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "FavoriteImage",
      "description": "User favorited images"
    }
  }
}
